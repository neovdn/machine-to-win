# =============================================================================
# Konfigurasi sistem analisis trading XAUUSD
# Salin file ini menjadi .env dan sesuaikan nilainya
# File .env TIDAK boleh di-commit ke git (sudah ada di .gitignore)
# =============================================================================

# --- Pengaturan Instrumen & Timeframe ---
# Nama simbol di MT5 (bisa berbeda tergantung broker, cek di MT5 Market Watch)
# Contoh umum: XAUUSD, XAUUSDm, GOLD
MT5_SYMBOL=XAUUSD

# Timeframe dalam menit. M5 = 5, M15 = 15, H1 = 60, dll.
# Nilai ini dipakai sebagai konstanta MT5 (M5 = mt5.TIMEFRAME_M5)
MT5_TIMEFRAME=M5

# Jumlah candle historis yang ditarik (500 candle M5 ≈ 41 jam)
MT5_CANDLE_COUNT=500
